# Copier en .env sur le NAS (ne jamais publier les valeurs reelles).
# Chemin Linux absolu du dossier source, pas le chemin SMB Windows.
# Le dossier doit deja exister. Aucun chemin interne du NAS n'est devine.
NAS_SOURCE_HOST_PATH=
# Blocage de tout transfert OCR externe tant que le traitement des donnees n'est pas autorise.
ALLOW_EXTERNAL_OCR=false
VERYFI_CLIENT_ID=
VERYFI_API_KEY=
VERYFI_AUTH_MODE=bearer
# VERYFI_USERNAME= (uniquement si mode standard)
NAS_ROOT=/data
SOURCE_DIR=/data/ENTREE_FACTURES
DEST_DIR=/data/FACTURES_CLASSEES
REVIEW_DIR=/data/A_VERIFIER
MIN_CONFIDENCE=0.90
SCAN_INTERVAL_SEC=60
DRY_RUN=true
LOG_LEVEL=INFO
